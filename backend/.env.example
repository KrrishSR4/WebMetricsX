# WebMetricsX Go Backend Environment Configuration

# Server Settings
PORT=8081
ENVIRONMENT=development

# CORS Settings (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://webmetricsx.web.app,http://localhost:5173,http://localhost:8080,http://localhost:8081

# Database Settings (V2.0 Persistence)
DATABASE_URL=postgres://user:password@localhost:5432/webmetricsx?sslmode=disable

# Redis Settings (V2.0 Cache & Queue)
REDIS_URL=redis://localhost:6379/0

# Resend Settings (Phase 2.7 Alerts Testing)
RESEND_API_KEY=
